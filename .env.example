# Copy to .env and fill in only what you use. Never commit .env.
# Provider profiles store only the NAME of the variable that holds the key.

# AI providers (optional: the offline simulated provider works without keys)
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# PIXELLAB_API_KEY=

# Where the catalog (SQLite), content-addressed blobs and exports live. Default: ./data
# PIXEL_STUDIO_DATA_DIR=./data

# Python interpreter of the raster pipeline. Default: ./python/.venv/bin/python
# PIXEL_STUDIO_PYTHON=

# Offline simulated provider (on by default outside production)
# PIXEL_STUDIO_SIMULATED_PROVIDER=1

# Extra hosts allowed to reach the web UI/API (default: loopback only), comma-separated
# PIXEL_STUDIO_ALLOWED_HOSTS=

# Tuning
# PIXEL_STUDIO_MAX_UPLOAD_BYTES=67108864
# PIXEL_STUDIO_MIN_FREE_BYTES=268435456
# PIXEL_STUDIO_PYTHON_TIMEOUT_MS=60000
# PIXEL_STUDIO_LEASE_MS=30000
