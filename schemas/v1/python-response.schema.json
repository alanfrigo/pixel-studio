{
  "$id": "pixel-studio/v1/python-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "report": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "protocolVersion",
        "status",
        "outputs",
        "report"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "needs_review"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "report": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "warnings": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "protocolVersion",
        "status",
        "outputs",
        "report",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "unsupported_protocol",
                "invalid_request",
                "unsupported_input",
                "decode_failed",
                "limit_exceeded",
                "geometry_mismatch",
                "internal"
              ]
            },
            "message": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "$ref": "#/$defs/__schema4"
                }
              ]
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "relPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mime": {
          "type": "string",
          "enum": [
            "image/png",
            "image/gif",
            "application/json"
          ]
        },
        "width": {
          "$ref": "#/$defs/__schema1"
        },
        "height": {
          "$ref": "#/$defs/__schema1"
        },
        "sha256": {
          "$ref": "#/$defs/__schema2"
        },
        "rgbaSha256": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "role",
        "relPath",
        "mime",
        "sha256"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/__schema4"
        }
      ]
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "pt-BR": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "pt-BR"
      ],
      "additionalProperties": false
    }
  }
}
